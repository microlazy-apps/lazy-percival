+# Multi-stage build for self-hosted Percival.
+#
+# Layer cache is the bottleneck — order COPYs so a Svelte-only edit doesn't
+# rebuild the WASM crate or re-download npm/go modules.
+#
+# Stages:
+#   wasm-builder  Rust + wasm-pack       -> crates/percival-wasm/pkg/
+#   web-builder   Node + Vite            -> dist/
+#   go-builder    Go + //go:embed dist   -> /percival
+#   final         distroless static      -> single binary, no shell
+#
+# The resulting image is a self-contained binary that serves the SPA on :8080.
+# Optional Gist sharing (/api) is gated by ENABLE_GIST_API=true at runtime.
+
+FROM rust:1.78-slim-bookworm AS wasm-builder
+WORKDIR /build
+RUN apt-get update \
+    && apt-get install -y --no-install-recommends curl ca-certificates \
+    && rm -rf /var/lib/apt/lists/*
+RUN curl -sSf https://rustwasm.github.io/wasm-pack/installer/init.sh | sh
+# Manifests first so cargo registry warm-up reuses cache when sources change.
+COPY Cargo.toml Cargo.lock ./
+COPY crates/percival/Cargo.toml         crates/percival/Cargo.toml
+COPY crates/percival-cli/Cargo.toml     crates/percival-cli/Cargo.toml
+COPY crates/percival-wasm/Cargo.toml    crates/percival-wasm/Cargo.toml
+RUN --mount=type=cache,target=/usr/local/cargo/registry \
+    mkdir -p crates/percival/src crates/percival-cli/src crates/percival-wasm/src \
+    && echo "" > crates/percival/src/lib.rs \
+    && echo "fn main() {}" > crates/percival-cli/src/main.rs \
+    && echo "" > crates/percival-wasm/src/lib.rs \
+    && cargo fetch --locked
+COPY crates ./crates
+RUN --mount=type=cache,target=/usr/local/cargo/registry \
+    --mount=type=cache,target=/build/target \
+    wasm-pack build --target web crates/percival-wasm
+
+FROM node:20-bookworm-slim AS web-builder
+WORKDIR /build
+# Lockfile + patches first so npm cache survives source-only edits.
+COPY package.json package-lock.json ./
+COPY patches ./patches
+COPY --from=wasm-builder /build/crates/percival-wasm/pkg ./crates/percival-wasm/pkg
+RUN --mount=type=cache,target=/root/.npm \
+    npm ci --no-audit --no-fund
+COPY . .
+# Re-stamp pkg in case .dockerignore would have hidden it from `COPY . .`.
+COPY --from=wasm-builder /build/crates/percival-wasm/pkg ./crates/percival-wasm/pkg
+RUN npm run build
+
+FROM golang:1.22-bookworm AS go-builder
+WORKDIR /build
+COPY go.mod go.sum ./
+RUN --mount=type=cache,target=/go/pkg/mod \
+    --mount=type=cache,target=/root/.cache/go-build \
+    go mod download
+COPY main.go ./
+COPY api ./api
+COPY --from=web-builder /build/dist ./dist
+RUN --mount=type=cache,target=/go/pkg/mod \
+    --mount=type=cache,target=/root/.cache/go-build \
+    CGO_ENABLED=0 GOOS=linux go build \
+        -trimpath -ldflags="-s -w" \
+        -o /percival ./
+
+FROM gcr.io/distroless/static-debian12:nonroot
+COPY --from=go-builder /percival /percival
+EXPOSE 8080
+USER nonroot:nonroot
+ENTRYPOINT ["/percival"]
