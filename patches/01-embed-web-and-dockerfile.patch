-// This file is a helper to locally run the serverless function defined in
-// `api/`, for development purposes. It shouldn't usually be relevant, unless
-// you want to work on the "share notebooks as GitHub Gists" feature in your
-// local development environment.
+// Self-hosted Percival entrypoint.
+//
+// Embeds the Vite-built `dist/` directory and serves it as a static site,
+// with `/api` (Gist sharing) routed to api.Handler when ENABLE_GIST_API=true.
+// Upstream `main.go` only existed for local API development; the public
+// percival.ink site is hosted on Vercel as a static front + serverless fn.
 
 package main
 
 import (
-	"fmt"
+	"embed"
+	"io/fs"
 	"log"
 	"net/http"
+	"os"
 
 	"percival.ink/api"
 )
 
-func main() {
-	http.HandleFunc("/api", api.Handler)
+//go:embed all:dist
+var distFS embed.FS
 
-	fmt.Println("Listening at http://localhost:3030/api")
-	err := http.ListenAndServe(":3030", nil)
+func main() {
+	addr := os.Getenv("LISTEN_ADDR")
+	if addr == "" {
+		addr = ":8080"
+	}
 
+	sub, err := fs.Sub(distFS, "dist")
 	if err != nil {
+		log.Fatalf("embedded dist/ unavailable: %v", err)
+	}
+
+	mux := http.NewServeMux()
+
+	if os.Getenv("ENABLE_GIST_API") == "true" {
+		mux.HandleFunc("/api", api.Handler)
+	} else {
+		mux.HandleFunc("/api", func(w http.ResponseWriter, r *http.Request) {
+			http.Error(w, "Gist sharing not enabled in self-hosted Percival.", http.StatusNotImplemented)
+		})
+	}
+
+	mux.HandleFunc("/health", func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "text/plain")
+		_, _ = w.Write([]byte("ok\n"))
+	})
+
+	mux.Handle("/", http.FileServer(http.FS(sub)))
+
+	log.Printf("Percival listening on %s", addr)
+	if err := http.ListenAndServe(addr, mux); err != nil {
 		log.Fatal(err)
 	}
 }
